      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "const root = $('Webhook WhatsApp').first().json;\nconst body = root.body ?? root;\nconst data = body.data ?? body;\nconst key = data.key ?? {};\nconst remoteJid = String(key.remoteJid || '');\nconst telefone = remoteJid.replace('@s.whatsapp.net','').replace('@lid','').replace(/\\D/g,'');\nconst instance = body.instance || body.instanceName || $json.instance || 'salao2';\nreturn [{\n  json: {\n    telefone: $json.telefone || telefone,\n    instance,\n    resposta: $json.resposta\n  }\n}];"
      },
      "id": "preparar-envio",
      "name": "Preparar Envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://evolution-api:8080/message/sendText/' + ($json.instance || 'salao2') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "salao_evolution_key" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.telefone }}\",\n  \"text\": {{ JSON.stringify($json.resposta) }}\n}",
        "options": { "timeout": 10000 }
      },
      "id": "enviar-whatsapp",
